# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Интервал проверки новых объявлений (в секундах, по умолчанию 300)
CHECK_INTERVAL=300

# Путь к файлу базы данных
DB_PATH=bot_data.db

# Прокси для обхода блокировки Авито (опционально)
# Формат: http://login:password@ip:port или socks5://login:password@ip:port
# PROXY_URL=http://user:pass@1.2.3.4:8080
